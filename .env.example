# Copy to .env and fill in. .env is gitignored.

# VITE_GOOGLE_MAPS_PLATFORM_KEY: Google Maps JavaScript API key for the interactive map.
# Create one at https://console.cloud.google.com/google/maps-apis/start and restrict it to your
# site's domains. The VITE_ prefix makes Vite include it in the browser bundle, so it is public.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# PORT: port the server listens on (default 3000). Most hosts set this for you.
PORT=3000

# TRUST_PROXY: set to the number of reverse-proxy hops in front of the server (usually 1 on
# hosted platforms) so rate limits apply per visitor instead of to the proxy's IP.
TRUST_PROXY=

# Optional rate limit overrides (requests per minute, per IP).
SEARCH_RATE_LIMIT_PER_MINUTE=10
IMAGE_PROXY_RATE_LIMIT_PER_MINUTE=300

# Python sidecar (Camoufox + curl_cffi). The Docker image starts it automatically; for local
# development run `npm run sidecar` in another terminal and set:
# SIDECAR_URL=http://127.0.0.1:8877
# If neither is set, providers use Node fetch and Chrome as before.
SIDECAR_URL=
SIDECAR_AUTOSTART=
# Only needed when the autostart uses a non-default interpreter (the image uses this path).
SIDECAR_PYTHON=
# Set to 1 to make `npm install` run the Render sidecar install locally (normally Render-only).
SIDECAR_INSTALL=
# Set to 0 to install only curl_cffi (skip the ~1 GB Camoufox and Chrome downloads).
SIDECAR_BROWSERS=
# Set to 0 to skip the ~1 GB Camoufox download in the Render/native install (the Dockerfile
# always includes it). If Camoufox cannot launch for lack of system libraries, /scrape falls back
# to Chrome automatically.
SIDECAR_CAMOUFOX=

# Proxy profiles the sidecar uses, keyed by name. Only BidSpotter uses one today ("mobile").
# JSON, e.g. SIDECAR_PROXIES={"mobile":{"server":"http://host:port","username":"u","password":"p"}}
# Locally, the sidecar also reads proxyList.txt / proxylist.txt lines in the form
# username:password@server:port and names the first one "mobile".
SIDECAR_PROXIES=
