# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for displaying the interactive map with cluster points.
# Get a key from the Google Cloud Console and paste it into Secrets.
GOOGLE_MAPS_PLATFORM_KEY=

# TRUST_PROXY: set to the number of reverse-proxy hops in front of the server (usually 1 on
# hosted platforms) so rate limits apply per visitor instead of to the proxy's IP.
TRUST_PROXY=

# Optional rate limit overrides (requests per minute, per IP).
SEARCH_RATE_LIMIT_PER_MINUTE=10
IMAGE_PROXY_RATE_LIMIT_PER_MINUTE=300
