{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "pro", "standard"] },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "preferredRadius": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "rules": {
        "read": "request.auth != null",
        "write": "request.auth != null && (request.auth.uid == resource.id || request.auth.token.role == 'admin')"
      }
    },
    "WatchlistItem": {
      "collection": "users/{userId}/watchlist",
      "fields": {
        "lotId": { "type": "string" },
        "title": { "type": "string" },
        "auctioneer": { "type": "string" },
        "location": { "type": "string" },
        "price": { "type": "number" },
        "endingDate": { "type": "string" },
        "url": { "type": "string" },
        "notes": { "type": "string" },
        "myMaxBid": { "type": "number" },
        "savedAt": { "type": "string" }
      },
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    "SearchAlert": {
      "collection": "users/{userId}/searchAlerts",
      "fields": {
        "keyword": { "type": "string" },
        "category": { "type": "string" },
        "radius": { "type": "number" },
        "createdAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "rules": {
        "read": "request.auth != null && request.auth.uid == userId",
        "write": "request.auth != null && request.auth.uid == userId"
      }
    },
    "PlatformBroadcast": {
      "collection": "announcements",
      "fields": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "rules": {
        "read": "true",
        "write": "request.auth != null"
      }
    }
  }
}
